# fetch: each input message is a JSON request descriptor, composed over the
# fetch block's own spec, then dispatched. Here jq builds {url: ...} per
# tenant slug upstream of fetch; the raw response goes to trash (a real
# pipeline would follow with jq/pick to reshape it).
#
# Build-only (no network in CI): validates the spec, including that url
# isn't required on the block since every message supplies its own.
import {
  shared = "shared.psy"
}

produce "generate" "tenants" {
  values     = ["\"stripe\"", "\"airbnb\""]
  stop-after = 2
}

transform "jq" "job-request" {
  expression = "{url: (\"https://boards-api.greenhouse.io/v1/boards/\" + . + \"/jobs\")}"
}

transform "fetch" "jobs" {}

pipeline "http-fetch" {
  produce   = [produce.generate.tenants]
  transform = [transform.jq.job-request, transform.fetch.jobs]
  consume   = [imports.shared.consume.trash.sink]
}
