# The request transport is dual-role: producing polls the URL, consuming
# performs one request per message. Build-only (no network): parsing +
# building validates the spec — map headers, list success codes, required
# url on the producer.
import {
  shared = "shared.psy"
}

produce "request" "api" {
  url           = "http://example.invalid/items"
  headers       = { "Authorization" = "Bearer x" }
  query-params  = { "page" = "1" }
  success-codes = [200, 204]
  stop-after    = 1
}

pipeline "http-request" {
  produce = [produce.request.api]
  consume = [imports.shared.consume.trash.sink]
}

# Each message the consumer receives is a JSON request descriptor, composed
# over the block below — here every message supplies its own url, and the
# block only pins down method and a default header.
produce "generate" "posts" {
  values     = ["{\"url\": \"http://example.invalid/items/1\"}"]
  stop-after = 1
}

consume "request" "post" {
  url     = "http://example.invalid/items"
  method  = "POST"
  headers = { "Authorization" = "Bearer x" }
}

pipeline "http-request-post" {
  produce = [produce.generate.posts]
  consume = [consume.request.post]
}
